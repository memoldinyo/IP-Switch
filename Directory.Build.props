<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Version>1.4.0</Version>
    <!-- Autor: wird in "Über IP-Switch", der Hilfe, den Dateieigenschaften und im MSI (Herausgeber) verwendet. -->
    <IPSwitchAuthor>Mehmet Aslandag</IPSwitchAuthor>
    <Product>IP-Switch</Product>
    <Authors>$(IPSwitchAuthor)</Authors>
    <Company>$(IPSwitchAuthor)</Company>
    <Copyright>Copyright © 2026 $(IPSwitchAuthor)</Copyright>
    <NeutralLanguage>de-DE</NeutralLanguage>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <!-- Debug-Informationen in die Assemblies einbetten (keine losen .pdb-Dateien im Paket). -->
    <DebugType Condition="'$(Configuration)' == 'Release' And '$(MSBuildProjectExtension)' == '.csproj'">embedded</DebugType>
  </PropertyGroup>
</Project>
