<?xml version="1.0" encoding="utf-8"?>
<!-- Paketbeschreibung für den Microsoft Store. build-msix.ps1 ersetzt die $...$-Platzhalter
     (Identität und reservierter App-Name aus identity.json, Version aus Directory.Build.props). -->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>$DisplayName$</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Switch IPv4 network profiles per adapter with one click</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="de-DE" />
    <Resource Language="tr-TR" />
    <Resource Language="fr-FR" />
    <Resource Language="it-IT" />
    <Resource Language="ar-SA" />
    <Resource Language="zh-CN" />
    <Resource Language="ru-RU" />
  </Resources>

  <Applications>
    <Application Id="IPSwitch" Executable="IPSwitch.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="$DisplayName$"
        Description="Switch IPv4 network profiles per adapter with one click"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Autostart: nach dem ersten Start eingeschaltet, abschaltbar unter Einstellungen › Apps › Autostart.
             IP-Switch erkennt diesen Start und bleibt dann ohne Fenster im Infobereich. -->
        <desktop:Extension Category="windows.startupTask" Executable="IPSwitch.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="IPSwitchStartup" Enabled="true" DisplayName="IP-Switch" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- Kein allowElevation (im Store zweimal abgelehnt): Der Hilfsprozess für Änderungen startet per UAC-Abfrage
         (ShellExecute "runas") auch ohne diese Berechtigung – getestet am 19.11.2026 mit Adapter aus/ein und
         "Jetzt mit Administratorrechten neu starten". -->
  </Capabilities>
</Package>
